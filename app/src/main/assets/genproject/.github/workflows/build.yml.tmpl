name: build-__PROJECT_SLUG__

on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'

      - name: Install SDK packages (compileSdk 35)
        run: |
          yes | "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" --licenses > /dev/null 2>&1 || true
          "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" "platforms;android-35" "build-tools;35.0.0"

      - name: Cache Gradle
        uses: actions/cache@v4
        with:
          path: |
            ~/.gradle/caches
            ~/.gradle/wrapper
          key: gradle-${{ runner.os }}-${{ hashFiles('gradle/libs.versions.toml', 'app/build.gradle') }}

      - name: Pulihkan keystore tetap dari secret
        env:
          GENAPP_KEYSTORE_BASE64: ${{ secrets.GENAPP_KEYSTORE_BASE64 }}
          GENAPP_KEYSTORE_PASSWORD: ${{ secrets.GENAPP_KEYSTORE_PASSWORD }}
          GENAPP_KEY_ALIAS: ${{ secrets.GENAPP_KEY_ALIAS }}
          GENAPP_KEY_PASSWORD: ${{ secrets.GENAPP_KEY_PASSWORD }}
        run: |
          set -euo pipefail
          if [ -z "${GENAPP_KEYSTORE_BASE64:-}" ]; then
            echo "::error::Secret GENAPP_KEYSTORE_BASE64 belum diisi — build dibatalkan agar APK tidak bertanda tangan acak. Lihat README.md bagian Penandatanganan."
            exit 1
          fi
          mkdir -p "$HOME/.android"
          printf '%s' "$GENAPP_KEYSTORE_BASE64" | base64 --decode > "$HOME/.android/genapp.keystore"
          test -s "$HOME/.android/genapp.keystore"
          {
            echo "GENAPP_STORE_FILE=$HOME/.android/genapp.keystore"
            echo "GENAPP_STORE_PASSWORD=$GENAPP_KEYSTORE_PASSWORD"
            echo "GENAPP_KEY_ALIAS=$GENAPP_KEY_ALIAS"
            echo "GENAPP_KEY_PASSWORD=$GENAPP_KEY_PASSWORD"
          } >> "$GITHUB_ENV"

      - name: Build release APK
        run: ./gradlew :app:assembleRelease --stacktrace

      - name: Verifikasi APK
        run: |
          set -euo pipefail
          APK=$(find app/build/outputs/apk/release -name "*.apk" | head -1)
          test -n "$APK"
          ls -lh "$APK"
          sha256sum "$APK"
          "$ANDROID_HOME/build-tools/35.0.0/aapt2" dump badging "$APK" | head -3
          "$ANDROID_HOME/build-tools/35.0.0/apksigner" verify --print-certs "$APK"

      - name: Upload APK artifact
        uses: actions/upload-artifact@v4
        with:
          name: __PROJECT_SLUG__-release-apk
          path: app/build/outputs/apk/release/*.apk
          if-no-files-found: error
